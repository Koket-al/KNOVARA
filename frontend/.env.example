# KNOVARA Frontend Environment Variables
# Public configuration for Vite client application (Never place private keys or secrets here)

VITE_NEAR_NETWORK=testnet
VITE_NEAR_CONTRACT_ID=koket-knovara-dev.testnet
VITE_NEAR_RPC_URL=https://rpc.testnet.near.org

# Relative path empty string uses the Vite dev server proxy (or Vercel rewrites)
VITE_BACKEND_API_URL=
VITE_DIRECT_API_URL=http://localhost:5000

