# KNOVARA Backend Environment Configuration
# Copy this file to .env and configure appropriate values for your environment.
# NEVER commit .env to version control!

# HTTP Server Configuration
PORT=5000
NODE_ENV=development

# Web Frontend Origin (for CORS and cookie credentials)
FRONTEND_ORIGIN=http://localhost:3000

# Trusted Frontend Callback Origins (comma-separated list for NEP-413 redirect validation)
ALLOWED_CALLBACK_ORIGINS=http://localhost:3000,https://knovara.vercel.app

# Reverse Proxy Trust Configuration (Render uses 1 proxy hop)
TRUST_PROXY=1

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/knovara?retryWrites=true&w=majority

# Session Security Configuration
# In production, use a 64-byte random hex string: openssl rand -hex 64
SESSION_SECRET=replace_with_64_byte_cryptographically_secure_random_hex
SESSION_MAX_AGE_MS=86400000

# NEAR Protocol Configuration
NEAR_NETWORK=testnet
NEAR_CONTRACT_ID=koket-knovara-dev.testnet
NEAR_RPC_URL=https://rpc.testnet.near.org

# Authentication Challenge Security
NONCE_TTL_SECONDS=300

# Cloudflare R2 Object Storage Configuration
# Obtain credentials from Cloudflare Dashboard > R2 > Manage R2 API Tokens
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_EVIDENCE_BUCKET=knovara-evidence
R2_REGION=auto
# Optional custom endpoint (default: https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT_URL=https://your_cloudflare_account_id_here.r2.cloudflarestorage.com
# Short-lived presigned upload URL validity (in seconds, e.g. 900 = 15 minutes)
R2_UPLOAD_URL_TTL_SECONDS=900
# Maximum permitted evidence file upload size in bytes (104857600 = 100 MB)
MAX_EVIDENCE_FILE_BYTES=104857600

# Public API Base URL for NEP-177 Metadata Reference Descriptors
PUBLIC_API_BASE_URL=http://localhost:5000

